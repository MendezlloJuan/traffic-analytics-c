<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BixIA | Inteligência Artificial Neural da BWG Brasil</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" relmargin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#050816;
    color:#fff;
    overflow-x:hidden;
}

header{
    position:fixed;
    width:100%;
    top:0;
    z-index:100;
    background:rgba(0,0,0,.3);
    backdrop-filter:blur(12px);
}

nav{
    max-width:1200px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px;
}

.logo{
    font-size:1.8rem;
    font-weight:700;
    color:#00e5ff;
}

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:100px 20px 40px;
    position:relative;
}

.hero::before{
    content:'';
    position:absolute;
    width:600px;
    height:600px;
    background:radial-gradient(circle,#00e5ff55,transparent 70%);
    border-radius:50%;
    filter:blur(60px);
}

.hero-content{
    position:relative;
    z-index:2;
    max-width:900px;
}

.hero h1{
    font-size:4rem;
    font-weight:700;
    margin-bottom:20px;
}

.highlight{
    color:#00e5ff;
}

.hero p{
    font-size:1.2rem;
    color:#cfd8dc;
    margin-bottom:35px;
}

.btn{
    display:inline-block;
    padding:15px 35px;
    background:#00e5ff;
    color:#000;
    text-decoration:none;
    border-radius:50px;
    font-weight:600;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-4px);
    box-shadow:0 0 25px #00e5ff;
}

.section{
    padding:80px 20px;
    max-width:1200px;
    margin:auto;
}

.title{
    text-align:center;
    font-size:2.5rem;
    margin-bottom:60px;
}

.cards{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:25px;
}

.card{
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.1);
    padding:30px;
    border-radius:20px;
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    border-color:#00e5ff;
}

.card h3{
    color:#00e5ff;
    margin-bottom:15px;
}

.ai-core{
    text-align:center;
    padding:100px 20px;
}

.circle{
    width:250px;
    height:250px;
    border-radius:50%;
    margin:auto;
    background:radial-gradient(circle,#00e5ff,#001d3d);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:2rem;
    font-weight:bold;
    animation:pulse 3s infinite;
    box-shadow:0 0 50px #00e5ff;
}

@keyframes pulse{
    0%{transform:scale(1);}
    50%{transform:scale(1.08);}
    100%{transform:scale(1);}
}

footer{
    text-align:center;
    padding:30px;
    border-top:1px solid rgba(255,255,255,.1);
    color:#aaa;
}

#status{
    color:#00ff88;
    margin-top:20px;
    font-weight:600;
}
</style>
</head>
<body>

<header>
    <nav>
        <div class="logo">BixIA</div>
        #sobreConhecer</a>
    </nav>
</header>

<section class="hero">
    <div class="hero-content">
        <h1>A Revolução da IA Neural da <span class="highlight">BWG Brasil</span></h1>
        <p>
            BixIA é uma plataforma avançada de inteligência artificial neural,
            criada para automatizar processos, analisar dados e potencializar
            decisões estratégicas com velocidade, precisão e inovação.
        </p>

        <a href="#sobre"ecnologia</a>

        <div id="status"></div>
    </div>
</section>

<section id="sobre" class="section">
    <h2 class="title">Capacidades da BixIA</h2>

    <div class="cards">
        <div class="card">
            <h3>Machine Learning</h3>
            <p>Aprendizado contínuo baseado em padrões, comportamento e análise preditiva.</p>
        </div>

        <div class="card">
            <h3>Automação Inteligente</h3>
            <p>Automatização de fluxos corporativos com decisões baseadas em IA.</p>
        </div>

        <div class="card">
            <h3>Neural Analytics</h3>
            <p>Interpretação avançada de grandes volumes de dados em tempo real.</p>
        </div>

        <div class="card">
            <h3>Visão Computacional</h3>
            <p>Reconhecimento visual e análise de imagens utilizando redes neurais profundas.</p>
        </div>
    </div>
</section>

<section class="ai-core">
    <h2 class="title">Núcleo Neural BixIA</h2>

    <div class="circle">
        BixIA
    </div>
</section>

<footer>
    © 2026 BWG Brasil • BixIA Neural Intelligence Platform
</footer>

<script>
const mensagens = [
    "✅ Sistema Neural Inicializado",
    "✅ Processando Redes Cognitivas",
    "✅ Aprendizado Adaptativo Ativado",
    "✅ BixIA Online"
];

let index = 0;

function atualizarStatus(){
    document.getElementById("status").innerHTML = mensagens[index];
    index++;

    if(index >= mensagens.length){
        index = 0;
    }
}

atualizarStatus();
setInterval(atualizarStatus, 2500);
</script>

</body>
</html>
